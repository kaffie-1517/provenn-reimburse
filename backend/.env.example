APP_ENV=development
DATABASE_URL=postgresql+asyncpg://provenn:provenn@localhost:5432/provenn
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000

# S3-compatible object storage (MinIO locally; S3 or R2 in production).
# On AWS with an instance role, leave the two keys empty.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=provenn
S3_SECRET_KEY=provenn-secret
S3_BUCKET=provenn

# Run the job worker inside the api process (single-instance hosting).
RUN_WORKER=false
